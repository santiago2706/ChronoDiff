{
  "name": "predictive-impact",
  "displayName": "Predictive Impact",
  "description": "Understand the impact of your code changes before they become problems.",
  "version": "0.0.1",
  "publisher": "predictive-impact",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "predictiveImpact.analyzeImpact",
